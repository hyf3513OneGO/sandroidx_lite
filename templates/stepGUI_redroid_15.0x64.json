{
  "agent": {
    "image": "hyf3513/agent-ubuntu-22.04:latest",
    "mounts": [
      {
        "volume": "",
        "container_path": "/root/data",
        "read_only": false
      }
    ],
    "required_env_variables": ["STEPFUN_API_KEY"],
    "setup_commands": [
      {
        "workdir": "/root/data",
        "run": "git clone https://github.com/hyf3513OneGO/gelab-zero_cloud.git"
      },
      {
        "workdir": "/root/data/gelab-zero_cloud",
        "run": "pip install -r requirements.txt"
      },
      {
        "workdir": "/root/data/gelab-zero_cloud",
        "run": "adb connect $ANDROID_SERIAL"
      }
    ],
    "running_variables": [
      {
        "name": "<sandroidx_prompt_1>",
        "description": "Agent的任务描述Prompt",
        "type": "string",
        "required": true
      }
    ],
    "running_commands": [
      {
        "workdir": "/root/data/gelab-zero_cloud",
        "run": "python examples/run_single_task.py \"<sandroidx_prompt_1>\""
      }
    ],
    "envs": {
      "STEPFUN_API_KEY": "your_api_key_here"
    }
  }
  ,
  "sandbox": {
    "type": "phone/redroid",
    "image": "redroid/redroid:15.0.0_64only-250627",
    "mounts": [
      {
        "volume": "",
        "container_path": "/data",
        "read_only": false
      }
    ],
    "ports": [
      "5555"
    ],
    "privileged": true,
    "args": [
      "androidboot.redroid_width=1080",
      "androidboot.redroid_height=1920",
      "androidboot.redroid_dpi=480",
      "androidboot.redroid_gpu_mode=auto"
    ],
    "apks":[
      {
        "name": "ADBKeyboard",
        "package_name": "com.android.adbkeyboard",
        "version": "2.0",
        "url_str": "https://github.com/senzhk/ADBKeyBoard/raw/refs/heads/master/ADBKeyboard.apk",
        "type": "remote"
      }
    ],
    "setup_adb_commands": [
      "shell ime enable com.android.adbkeyboard/.AdbIME",
      "shell ime set com.android.adbkeyboard/.AdbIME",
      "shell settings put system screen_off_timeout 600000"
    ],
    "envs": {
      "TZ": "Asia/Shanghai"
    }
  }
}